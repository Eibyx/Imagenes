<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:id="@+id/themesStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="13sp" />

        <!-- Fuente -->
        <TextView style="@style/Section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/section_font" />
        <Button android:id="@+id/pickFont" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/pick_font" />
        <TextView android:id="@+id/fontInfo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/no_file" android:paddingVertical="4dp" />
        <ImageView android:id="@+id/fontPreview" android:layout_width="match_parent"
            android:layout_height="64dp" android:scaleType="fitCenter" android:visibility="gone"
            android:contentDescription="@null" />
        <EditText android:id="@+id/fontTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/hint_title" android:inputType="text" />
        <EditText android:id="@+id/fontAuthor" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/hint_author" android:inputType="text" />
        <EditText android:id="@+id/ttcIndex" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/hint_ttc_index" android:inputType="number"
            android:visibility="gone" />
        <CheckBox android:id="@+id/optFallback" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/opt_fallback" />
        <Button android:id="@+id/buildFont" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/build_font" android:enabled="false" />

        <!-- Iconos -->
        <TextView style="@style/Section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/section_icons" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/pickApk" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/pick_apk" />
            <Button android:id="@+id/pickInstalled" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="@string/pick_installed" />
        </LinearLayout>
        <TextView android:id="@+id/iconInfo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/no_file" android:paddingVertical="4dp" />
        <EditText android:id="@+id/iconTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/hint_title" android:inputType="text" />
        <EditText android:id="@+id/iconSize" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="@string/hint_icon_size" android:inputType="number" />
        <CheckBox android:id="@+id/optActivityIcons" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:checked="true" android:text="@string/opt_activity_icons" />
        <Button android:id="@+id/buildIcons" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/build_icons" android:enabled="false" />

        <!-- Resultado -->
        <TextView style="@style/Section" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/section_result" />
        <ProgressBar android:id="@+id/progress" style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:id="@+id/resultText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/no_result" android:textIsSelectable="true" />
        <Button android:id="@+id/openThemes" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/open_themes" />
        <Button android:id="@+id/applyMtz" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/apply_experimental" android:enabled="false" />
        <Button android:id="@+id/share" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/share" android:enabled="false" />
    </LinearLayout>
</ScrollView>
